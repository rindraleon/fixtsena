# ─── Application ──────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api
# Origine(s) autorisée(s) par CORS — séparées par des virgules
# (doit correspondre à l'URL du frontend Vite : VITE_API_URL=http://localhost:3000/api)
CORS_ORIGIN=http://localhost:5173

# ── Database (PostgreSQL) ───────────────────────────────
# Mode 1 (local / Docker) : variables séparées
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=tsena
DATABASE_PASSWORD=tsena_secret
DATABASE_NAME=tsena_db
# Mode 2 (Render, Railway…) : une seule URL — prioritaire sur les variables ci-dessus
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# TLS vers la base : auto (true si DATABASE_URL distante) — forcer avec true/false
# DATABASE_SSL=true
# Schéma géré par les migrations : elles s'exécutent automatiquement au démarrage de l'API
# (dev comme prod), sur une base vierge comme sur une base existante.
# DATABASE_SYNCHRONIZE=true  → régénère le schéma depuis les entités (défaut : false, jeux de données jetables)
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=false

# ── Compte administrateur ────────────────────────────────
# Aucune variable : le PREMIER compte inscrit avec le choix « Administrateur » (formulaire /inscription)
# devient admin. Dès qu'un admin existe, ce choix disparaît du formulaire et le backend le refuse (403).
# ADMIN_SELF_REGISTRATION=false  → interdit ce canal même sur une base vierge (admin créé par `npm run seed`)

# ── JWT ─────────────────────────────────────────────────
# Access token (court) — signé avec JWT_SECRET
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=15m
# Refresh token (long, rotation à chaque usage) — signé avec JWT_REFRESH_SECRET
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_REFRESH_EXPIRATION=7d

# ─── S3-compatible object storage ────────────────────────
# Tous les fichiers (produits, catégories, avatars, boutiques, litiges, pièces jointes de messages)
# sont stockés dans le MÊME bucket, rangés par préfixe de clé : products/<id>/…, avatars/<id>/…
# En production (ex. Neon), configurer ces variables et autoriser la lecture publique du bucket.
# ATTENTION : cette permission rend publics TOUS les objets, y compris les preuves de litige et fichiers de messages.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=
# Base des URL publiques (optionnelle ; par défaut l'endpoint S3) — ne pas ajouter le nom du bucket.
S3_PUBLIC_URL=

# Configuration MinIO pour le développement local (utilisée si AWS_ENDPOINT_URL_S3 est vide).
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
# Identifiants du serveur MinIO local.
MINIO_ACCESS_KEY=tsena
MINIO_SECRET_KEY=tsena-secret-change-me
MINIO_BUCKET=tsena
MINIO_REGION=us-east-1
# URL publique MinIO si différente de l'endpoint interne (ex. https://cdn.tsena.mg).
MINIO_PUBLIC_URL=

# ─── Bcrypt ──────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ─── MVola (Madagascar Mobile Money) ────────────────────
MVOLA_API_URL=https://api.mvola.mg
MVOLA_API_KEY=your_mvola_api_key
MVOLA_MERCHANT_ID=your_merchant_id

# ─── Airtel Money (Madagascar) ──────────────────────────
AIRTEL_API_URL=https://api.airtelmoney.mg
AIRTEL_API_KEY=your_airtel_api_key
AIRTEL_MERCHANT_ID=your_airtel_merchant_id

# ─── Email Verification ──────────────────────────────────
EMAIL_VERIFICATION_TOKEN_EXPIRY_HOURS=24
EMAIL_VERIFICATION_RESEND_COOLDOWN_MINUTES=2

# ─── Password Reset ─────────────────────────────────────
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=60
PASSWORD_RESET_MAX_TOKENS_PER_HOUR=3

# ─── Security ────────────────────────────────────────────
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_DURATION_MINUTES=15

# ─── Mail (SMTP via nodemailer) ──────────────────────────
# Sans MAIL_HOST : mode « log » (aucun envoi, contenu dans les logs). Avec MAIL_HOST : envoi réel.
# Tous les e-mails du projet passent par là : vérification d'adresse, réinitialisation / changement
# de mot de passe, alertes de sécurité, notifications (commandes, litiges, messagerie…).
# Diagnostic sans terminal : GET /api/admin/mail/status, POST /api/admin/mail/verify, POST /api/admin/mail/test
#
# Gmail : activer la validation en 2 étapes puis créer un « mot de passe d'application » (16 caractères) ;
#         MAIL_FROM doit être l'adresse du compte Gmail (Gmail réécrit l'expéditeur sinon). ~500 mails/jour.
# Brevo (recommandé, 300/jour gratuits, domaine personnalisé) : MAIL_HOST=smtp-relay.brevo.com MAIL_PORT=587
#         MAIL_USER=<login SMTP Brevo> MAIL_PASSWORD=<clé SMTP>  MAIL_FROM=<expéditeur validé chez Brevo>
# Local (Mailpit : docker run -p 1025:1025 -p 8025:8025 axllent/mailpit) : MAIL_HOST=localhost MAIL_PORT=1025
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
# MAIL_SECURE=false            # true = TLS implicite (port 465) ; défaut : auto selon le port
# MAIL_DRIVER=smtp             # smtp | log (forcer le mode log même avec MAIL_HOST)
# MAIL_REQUIRE_TLS=true        # exige STARTTLS (défaut : true sauf localhost)
# MAIL_TLS_REJECT_UNAUTHORIZED=true
# MAIL_TIMEOUT_MS=10000
# MAIL_POOL=false
# MAIL_VERIFY_ON_BOOT=true     # teste la connexion au démarrage (non bloquant, résultat dans les logs)
MAIL_FROM=noreply@tsena.mg
MAIL_FROM_NAME=Tsena Marketplace
MAIL_REPLY_TO=support@tsena.mg
APP_URL=http://localhost:5173
APP_NAME=Tsena

# ── Rate limiting (par IP) ──────────────────────────────
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=300


# Webhook paiement : secret partagé avec le provider (HMAC-SHA256 — en-têtes x-tsena-signature / x-tsena-timestamp)
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret-change-me
# PAYMENT_WEBHOOK_ALLOW_UNSIGNED=true  # développement uniquement : accepter les callbacks non signés
# MAINTENANCE_DISABLED=true            # désactiver les tâches planifiées
